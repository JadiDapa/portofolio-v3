# Copy to .env.local and fill in. Never commit real values.

# --- Database (Postgres / Neon) ---
# Pooled connection used by the app at runtime and during `next build` prerendering
DATABASE_URL=
# Direct (non-pooled) connection for `prisma migrate` — optional, falls back to DATABASE_URL
DIRECT_URL=

# --- Clerk ---
# Public key: inlined into the client bundle at build time
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- UploadThing ---
UPLOADTHING_TOKEN=

# --- Contact form mail (SMTP) ---
SMTP_USER=
SMTP_PASS=
# Optional — defaults to SMTP_USER
CONTACT_TO_EMAIL=

# --- Site (optional) ---
# Canonical URL; defaults to https://www.daffaalthaf.my.id. Inlined at build time.
NEXT_PUBLIC_SITE_URL=
# Google Search Console meta tag; baked into prerendered HTML at build time
GOOGLE_SITE_VERIFICATION=

# --- Docker Compose only (optional) ---
# Host port for the production container (default 3000) and the dev container (default 3002)
APP_PORT=
DEV_PORT=
